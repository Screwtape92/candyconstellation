{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true
  },
  "include": [
    "*.ts",
    "../api/shared/antiCheat.ts",
    "../api/shared/inputValidation.ts",
    "../api/shared/scoreKey.ts"
  ],
  "exclude": ["dist"]
}
